{
    "dao_type": "Sqlite",
    "work_dir": "./",
    "sqlite_options": {
        "memory_mode": false,
        "pool_size": 2,
        "shared_cache": false,
        "pragma": {
            "journal_mode": "WAL",
            "busy_timeout": "1000"
        }
    },
    "swagger": {
        "enable": false,
        "swagger_config_path": "/openapi.yml",
        "swagger_index_path": null
    },
    "web": {
        "enable": false,
        "default_file": "index.html",
        "prefix": "/",
        "static_path": "static"
    },
    "bind_port": 3000,
    "max_clients": 100000,
    "enable_log": true,
    "threads": 2,
    "workers": 1,
    "custom_headers": {
        "Access-Control-Allow-Origin": "*"
    },
    "cors_headers": {
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
    }
}