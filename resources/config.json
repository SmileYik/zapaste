{
    "dao_type": "Sqlite",
    "work_dir": "./",
    "upload_dir": "uploads",
    "auth": {
        "auth_type": "None",
        "basic": {
            "users": null
        },
        "skip_auth_path": {
            "/swagger": "GET",
            "/swagger/:any": "GET",
            "/api/paste": "GET",
            "/api/paste/:name": "GET,POST",
            "/api/paste/:name/file/name/:filename": "GET,POST"
        }
    },
    "sqlite_options": {
        "memory_mode": false,
        "pool_size": 2,
        "shared_cache": false,
        "pragma": {
            "journal_mode": "WAL",
            "busy_timeout": "1000"
        }
    },
    "swagger": {
        "enable": false,
        "swagger_config_path": "/openapi.yml",
        "swagger_index_path": null
    },
    "web": {
        "enable": false,
        "default_file": "index.html",
        "prefix": "/",
        "static_path": "static",
        "compression_static": false
    },
    "bind_port": 3000,
    "max_clients": 100000,
    "enable_log": true,
    "threads": 2,
    "workers": 1,
    "paste_clean_frequency": 3600000,
    "custom_headers": {
        "Access-Control-Allow-Origin": "*"
    },
    "cors_headers": {
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
    }
}